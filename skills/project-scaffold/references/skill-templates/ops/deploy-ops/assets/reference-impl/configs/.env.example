# .env.example —— 应用/后端基础变量模板（通用骨架 · 按项目替换）
#
# 键集 SSOT：各环境 <env>/.env.<env> 的键集须与本文件一致；真值不入库，*.example 恒占位。
# 密钥取值来源登记 docs/L4/DEPLOYMENT.md §6；敏感项留空。

# 应用
DEBUG=false
APP_PORT=8000

# 数据源（示例键，按项目实际替换）
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# 鉴权
JWT_SECRET=

# 外部服务（示例）
LLM_PROVIDER=
LLM_API_KEY=
