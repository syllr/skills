# compose.env.example —— compose 层变量模板（通用骨架 · 按项目替换）
#
# 部署机复制为 <env>/.env（gitignore，仅部署机存在）；docker compose 自动读取同目录 .env。
# 这些变量只做 compose 文件里 ${VAR} 的替换，不进应用（应用配置见 <env>/.env.<env>）。

# 宿主端口
BACKEND_PORT=8000
FRONTEND_PORT=8080

# 版本标识（由 release 脚本写入，见 DEPLOYMENT §5.2）
BUILD_COMMIT=
BUILD_TIME=

# 敏感覆盖（留空；真值仅存部署机，取值来源见 DEPLOYMENT §6）
JWT_SECRET=
