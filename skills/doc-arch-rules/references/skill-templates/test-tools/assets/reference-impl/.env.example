# test-tools 环境变量模板（复制后填写；真值不入库）
#
# 多环境约定：为每个环境建一份 .env.<环境名>（环境名以 docs/L4/DEPLOYMENT.md §2.1 环境矩阵为准）
#   cp .env.example .env.standalone     # 或 .env.dev / .env.prod
#   cp .env.example .env                # .env = 无 --env 时的默认环境（建议本地 standalone）
# 运行：npm run api -- --env standalone ...     # 或 env 变量 TEST_ENV=standalone
#   四工具统一支持 --env <环境名>（ragflow 放子命令之后）；指定环境但文件不存在会直接报错，不回退默认
# 凭据文件已 gitignore（.env / .env.*，仅 .env.example 入库）——勿把真值写进本文件

# 后端契约直调（api）
# API_BASE=http://localhost:8000/api/v1
# API_TOKEN=
# HTTP_TIMEOUT_MS=30000

# 前端页面（webmcp）
# WEBMCP_URL=http://localhost:8080
# WEBMCP_TIMEOUT_MS=30000

# 向量库对账（ragflow）
# RAGFLOW_BASE_URL=http://localhost:9380/api/v1
# RAGFLOW_API_KEY=

# 业务库只读对账（db）
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=
# DB_NAME=audit_hub
